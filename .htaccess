Options -MultiViews
RewriteEngine On

# check if request is not an existing file
RewriteCond %{REQUEST_FILENAME} !-f

# check if request is not an existing directory
RewriteCond %{REQUEST_FILENAME} !-d

# Redirect to index.html
RewriteRule ^ index.html [QSA,L]

<ifModule mod_headers.c>
  # fyi: Apache matchers work in reverse order; the last matching rule takes precedence

  # Revalidate non-webpack assets on each request, since it can be more difficult
  # to validate if they change
  <filesMatch "\.(html?|js|css|png|jpe?g|gif|svg|ico|webmanifest|pdf)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </filesMatch>

  # Webpack gives files a unique hash in their name, so we can use that as the cache metric
  # instead
  <filesMatch "\.[0-9a-f]{20}\.(js|css|png|jpe?g|gif|svg|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </filesMatch>
</ifModule>
